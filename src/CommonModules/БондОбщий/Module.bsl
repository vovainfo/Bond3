// Получить индекс следующей страницы из cursor ответа MOEX
// 
// Параметры:
//  ТелоОтвета - Соответствие - Тело ответа от MOEX API
// 
// Возвращаемое значение:
//  Число, Неопределено - Индекс начала следующей страницы или Неопределено, если данных больше нет
Функция ПолучитьСледующийИндексИзКурсора(ТелоОтвета)
	
	Если ТелоОтвета["history.cursor"] = Неопределено ИЛИ ТелоОтвета["history.cursor"].Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИнфоКурсор = ТелоОтвета["history.cursor"][0];
	ТекущийИндекс = Число(ИнфоКурсор["INDEX"]);
	РазмерСтраницы = Число(ИнфоКурсор["PAGESIZE"]);
	ВсегоЗаписей = Число(ИнфоКурсор["TOTAL"]);
	
	Если ТекущийИндекс + РазмерСтраницы < ВсегоЗаписей Тогда
		Возврат ТекущийИндекс + РазмерСтраницы;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Записать одну котировку в регистр сведений КотировкиЦБ
// 
// Параметры:
//  СтрокаДанных - Соответствие - Строка данных котировки из ответа MOEX
//  Тикер - СправочникСсылка.Облигации - Ссылка на облигацию
Процедура ЗаписатьКотировкуВРегистр(СтрокаДанных, Тикер)
	
	Если НЕ ЗначениеЗаполнено(СтрокаДанных["TRADEDATE"]) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаЗаписи = ПрочитатьДатуJSON(СтрокаДанных["TRADEDATE"], ФорматДатыJSON.ISO);
	
	НаборЗаписей = РегистрыСведений.КотировкиЦБ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ДатаЗаписи);
	НаборЗаписей.Отбор.ЦБ.Установить(Тикер);
	
	Запись = НаборЗаписей.Добавить();
	Запись.Период = ДатаЗаписи;
	Запись.ЦБ = Тикер;
	
	// Заполнение ресурсов регистра из данных MOEX
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "CLOSE", Запись, "ЦенаЗакрытия");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "OPEN", Запись, "ЦенаОткрытия");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "HIGH", Запись, "ЦенаМаксимум");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "LOW", Запись, "ЦенаМинимум");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "VOLUME", Запись, "Объем");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "VALUE", Запись, "ОбъемРубли");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "ACCINT", Запись, "НКД");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "NUMTRADES", Запись, "СделокКоличество");
	ЗаполнитьЧисловоеПолеИзJSON(СтрокаДанных, "LEGALCLOSEPRICE", Запись, "ЦенаПоследняя");
	
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			НСтр("ru='Загрузка котировок'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			Тикер,
			СтрШаблон(НСтр("ru='Ошибка записи котировок за %1: %2'"), ДатаЗаписи, ТекстОшибки)
		);
	КонецПопытки;
	
КонецПроцедуры

// Заполнить числовое поле из JSON если значение существует
// 
// Параметры:
//  СтрокаJSON - Соответствие - Строка данных JSON
//  ИмяПоляJSON - Строка - Имя поля в JSON
//  ЗаписьРегистра - RegisterRecord.КотировкиЦБ - Запись регистра
//  ИмяПоляРегистра - Строка - Имя поля в регистре
Процедура ЗаполнитьЧисловоеПолеИзJSON(СтрокаJSON, ИмяПоляJSON, ЗаписьРегистра, ИмяПоляРегистра)
	Значение = СтрокаJSON.Получить(ИмяПоляJSON);
	Если Значение <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
		ЗаписьРегистра[ИмяПоляРегистра] = Число(Значение);
	КонецЕсли;
КонецПроцедуры

// Очистить значения всех реквизитов элемента справочника
// 
// Параметры:
//  ЭлементОбъект - СправочникОбъект - Элемент справочника
Процедура ОчиститьОбъект(ЭлементОбъект)
	РеквизитыОбъекта = ЭлементОбъект.Метаданные().Реквизиты;
	Для Каждого Реквизит Из РеквизитыОбъекта Цикл
		ЭлементОбъект[Реквизит.Имя] = Неопределено;		
	КонецЦикла; 
	Для Каждого ТЧ Из ЭлементОбъект.Метаданные().ТабличныеЧасти Цикл
		ЭлементОбъект[ТЧ.Имя].Очистить();
	КонецЦикла;
КонецПроцедуры
#КонецОбласти
